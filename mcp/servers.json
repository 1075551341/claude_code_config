{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/servers",
  "_comment": "MCP 分组视图 v10.12 | 权威源: .mcp.json（常驻6）| 按需/声明分组与 mcp-configs/ 文件一一对应；codebase-memory 已永久禁用（仅 optional-dev.json disabled/archive 记录）",
  "toolsets": {
    "always": ["codegraph", "crawl", "fetch", "git", "fs", "time"],
    "ops": ["redis", "sqlite", "docker", "postgres"],
    "optional-dev": ["chrome-devtools", "exa"],
    "collab": ["figma", "linear", "notion", "slack"],
    "search": ["exa"]
  },
  "on_demand_profiles": {
    "ops": "mcp-configs/ops.json",
    "optional-dev": "mcp-configs/optional-dev.json",
    "collab": "mcp-configs/collab.json",
    "search": "mcp-configs/search.json"
  },
  "loading": {
    "default": "always",
    "env": "CLAUDE_MCP_PROFILE",
    "profiles": {
      "ops": "always + merge ops profile",
      "optional-dev": "always + merge optional-dev profile",
      "full": "always + ops + optional-dev"
    }
  }
}
