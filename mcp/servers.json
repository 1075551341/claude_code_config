{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/servers",
  "_comment": "MCP 分组视图。权威源: .mcp.json（本地代码+grep）。context7/exa/playwright/firecrawl 走 Claude Plugins。chrome-devtools/postgres 默认关、中断启用。github 不常驻。无 aider-repo-map/sequential-thinking。",
  "toolsets": {
    "always_local_code": ["codegraph", "code-review-graph", "serena"],
    "always_remote_explore": ["grep"],
    "always_web_docs": [],
    "plugins": ["context7", "exa", "playwright", "firecrawl"],
    "plugins_default_off": ["chrome-devtools", "github"],
    "debug": ["chrome-devtools"],
    "fsaccess": ["fs"],
    "ops": ["redis", "sqlite", "docker", "postgres"],
    "collab": ["figma", "linear", "notion", "slack"]
  },
  "on_demand_profiles": {
    "debug": "mcp-configs/debug.json",
    "fsaccess": "mcp-configs/fsaccess.json",
    "ops": "mcp-configs/ops.json",
    "collab": "mcp-configs/collab.json"
  },
  "views": {
    "core": "mcp-configs/core.json",
    "dev": "mcp-configs/dev.json",
    "search": "mcp-configs/search.json",
    "optional-dev": "mcp-configs/optional-dev.json"
  },
  "loading": {
    "default": "always",
    "env": "CLAUDE_MCP_PROFILE",
    "profiles": {
      "debug": "always + merge debug profile",
      "ops": "always + merge ops profile",
      "full": "always + debug + ops"
    }
  }
}
