      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\apdms",
        "C:\\Users\\DELL\\.claude"
      ],
      "command": "npx"
    },
    "gh": {
      "_description": "GitHub API 集成。场景：管理 PR/Issue、查看 Actions 状态、搜索仓库",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "git": {
      "_description": "Git 版本库直接操作（新增）。场景：查看提交历史、diff、blame、本地分支操作",
      "args": [
        "mcp-server-git",
        "--repository",
        "D:\\apdms"
      ],
      "command": "uvx"
    },
    "memory": {
      "_description": "跨会话记忆持久化。场景：记住项目架构决策、用户偏好、重要上下文",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx"
    },
    "postgres": {
      "_description": "PostgreSQL 数据库。场景：生产环境复杂查询、事务处理、JSON 数据存储",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:password@localhost:5432/dbname"
      ],
      "command": "npx"
    },
    "puppeteer": {
      "_description": "Puppeteer Chrome 自动化（备选）。场景：PDF 生成、性能分析、DevTools 调试",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "command": "npx"
    },
    "pw": {
      "_description": "Playwright 浏览器自动化（首选）。场景：E2E 测试、网页截图、表单填写、多浏览器兼容",
      "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--headless",
        "--browser",
        "chromium"
      ],
      "command": "npx"
    },
    "redis": {
