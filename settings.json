    "ctx7": {
      "_description": "Context7 技术文档查询。场景：查 React/Vue/Express/Node 等库的最新 API",
      "args": [
        "-y",
        "@context7/mcp-server"
      ],
      "command": "npx"
    },
    "exa": {
      "_description": "Exa AI 语义搜索引擎。场景：智能搜索、语义检索、AI搜索",
      "args": [
        "-y",
        "@context7/mcp-exa-server"
      ],
      "command": "npx",
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
