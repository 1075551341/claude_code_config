  "language": "Chinese",
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "_comment": "Claude Code 主配置文件 - 修改后运行 sync-tools.ps1 同步到其他编辑器",
  "_hooks_section": "Hooks 执行顺序经过优化：格式化→检查→日志→安全→文档→测试→提交",
  "_mcp_section": "MCP 服务器配置（共 15 个，与 .mcp.json 同步）",
  "_model_section": "模型配置（同步时保留，不覆盖其他编辑器）",
  "_plugins_section": "插件配置",
  "autoUpdaterStatus": "enabled",
  "mcpServers": {
    "crawl": {
      "_description": "Firecrawl 网页爬取。场景：提取网页正文内容、批量采集数据、抓取文档",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "command": "npx",
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
