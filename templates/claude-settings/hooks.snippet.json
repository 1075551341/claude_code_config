{
  "_comment": "settings.json 的 hooks 段快照（v12：encoding 守卫 + pre-explore-router + Stop 审查硬门）。{{CLAUDE_HOME}} 由 scripts/apply-settings.py 替换。settings.json 无密钥可版本化；机器项在 settings.local.json。",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-edit-format.py",
            "timeout": 30000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-encoding-check.py",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-secret-detector.py",
            "timeout": 10000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-edit-verify-tracker.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "_comment": "v10.17: MCP 写工具（serena/fs）此前完全绕过验证追踪链，Stop 硬门因此误判「本会话未改代码」而放行回归。matcher 必须带 .*，裸 mcp__serena 会被当精确名而永不触发。此组不含 post-edit-format：符号级编辑后自动格式化属新增行为，保持既有语义不变。v11.4.2: 编码校验纳入此组。",
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-encoding-check.py",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-secret-detector.py",
            "timeout": 10000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-edit-verify-tracker.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "mcp__serena__.*|mcp__fs__.*"
      },
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/post-edit-verify-tracker.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Bash|Task"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-compact-state.py",
            "timeout": 15000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "_comment": "v11.4.6 图谱保鲜：查询/Grep/写工具前 ensure；建图类 MCP 放行。timeout 90s 覆盖首次 init。",
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-graph-freshness.py",
            "timeout": 90000,
            "type": "command"
          }
        ],
            "matcher": "mcp__codegraph__.*|mcp__code-review-graph__.*|mcp__serena__.*|mcp__fs__.*|Grep|Glob|Edit|Write|MultiEdit|Bash"
      },
      {
        "_comment": "v12 R17 软门：结构探索前须 codegraph_explore；CLAUDE_R17_MODE=deny 可升级阻断。",
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-explore-router.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Grep|Glob|Read|mcp__codegraph__.*"
      },
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-edit-impact-nudge.py",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-read-before-edit.py",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-encoding-snapshot.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "_comment": "v10.17: MCP 写工具的变更影响门（每文件首次编辑注入）。不含 pre-read-before-edit：serena 符号级编辑自带定位语义，强制先 Read 会误伤。v11.4.2: 编码快照纳入此组。",
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-edit-impact-nudge.py",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-encoding-snapshot.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "mcp__serena__.*|mcp__fs__.*"
      },
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-manifest-validator.py",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "Skill|Task"
      },
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-context-injector.py",
            "timeout": 8000,
            "type": "command"
          }
        ],
        "matcher": "Task|Bash|Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-rtk-rewrite.py",
            "timeout": 12000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-bash-guard.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/session-start-bootstrap.py",
            "timeout": 120000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/stop-verification-gate.py",
            "timeout": 180000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/stop-session-summary.py",
            "timeout": 30000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/stop-readme-updater.py",
            "timeout": 30000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-userprompt-issue-tracker.py",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "python {{CLAUDE_HOME}}/hooks/_editor_hook_launcher.py {{CLAUDE_HOME}}/hooks/pre-userprompt-verify-gate.py",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
