{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/session-start-bootstrap.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-userprompt-issue-tracker.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-userprompt-verify-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-graph-freshness.py\"",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-explore-router.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|StrReplace|SearchReplace|NotebookEdit|EditNotebook|Delete|MCP:.*|mcp__serena__.*|mcp__fs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-edit-impact-nudge.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-read-before-edit.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-encoding-snapshot.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "exec_command|shell|Shell|Bash|RunCommand|beforeShellExecution",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-rtk-rewrite.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-bash-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Task|spawn_agent|followup_task|update_plan|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-manifest-validator.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-context-injector.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|StrReplace|SearchReplace|NotebookEdit|EditNotebook|Delete|MCP:.*|mcp__serena__.*|mcp__fs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/post-edit-format.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/post-encoding-check.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/post-secret-detector.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/post-edit-verify-tracker.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "exec_command|shell|Shell|Bash|Task|spawn_agent|followup_task|CreatePlan|update_plan",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/post-edit-verify-tracker.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/pre-compact-state.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/stop-verification-gate.py\"",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/stop-session-summary.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CLAUDE_HOME}}/hooks/_codex_hook_runner.py\" \"{{CLAUDE_HOME}}/hooks/stop-readme-updater.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
