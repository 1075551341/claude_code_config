{
  "version": 1,
  "guard_version": "1.2.11",
  "hooks": {
    "sessionStart": [
      {
        "command": "python hooks/session_bootstrap.py",
        "timeout": 120
      }
    ],
    "sessionEnd": [
      {
        "command": "python hooks/session_end.py",
        "timeout": 45
      }
    ],
    "preCompact": [
      {
        "command": "python hooks/pre_compact_snapshot.py",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python hooks/sync_on_prompt.py",
        "matcher": "UserPromptSubmit",
        "timeout": 130
      },
      {
        "command": "python hooks/prompt_secret_scan.py",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      },
      {
        "command": "python hooks/compress_on_prompt.py",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      },
      {
        "command": "python hooks/issue_tracker.py",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      },
      {
        "command": "python hooks/verification_gate.py",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python hooks/shell_guard.py",
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python hooks/graph_freshness.py",
        "timeout": 90
      }
    ],
    "preToolUse": [
      {
        "command": "python hooks/graph_freshness.py",
        "matcher": "CallMcpTool|CallDynamicTool|Grep|Glob|Write|StrReplace|EditNotebook|Delete|Shell|MCP:.*|mcp__codegraph__.*|mcp__code-review-graph__.*|mcp_codegraph_.*|mcp_code-review-graph_.*|mcp__serena__.*|mcp__fs__.*|mcp_serena_.*|mcp_fs_.*",
        "timeout": 90
      },
      {
        "command": "python hooks/context_pre_tool.py",
        "matcher": "Task|Shell|Write|StrReplace|Read|Grep|Glob",
        "timeout": 5
      },
      {
        "command": "python hooks/explore_router.py",
        "matcher": "Grep|Read|Glob",
        "timeout": 5
      },
      {
        "command": "python hooks/impact_nudge.py",
        "matcher": "Write|StrReplace|EditNotebook|Delete|mcp__serena__.*|mcp__fs__.*|mcp_serena_.*|mcp_fs_.*",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "python hooks/context_post_tool.py",
        "matcher": "Task|Shell|Write|StrReplace|Read|Grep|Glob",
        "timeout": 5
      },
      {
        "command": "python hooks/verify_tracker.py",
        "matcher": "Write|StrReplace|EditNotebook|Delete|Shell|Task|CreatePlan|SwitchMode|CallDynamicTool|mcp__serena__.*|mcp__fs__.*|mcp_serena_.*|mcp_fs_.*",
        "timeout": 5
      },
      {
        "command": "python hooks/first_edit_verify.py",
        "matcher": "Write|StrReplace|EditNotebook|Delete|mcp__serena__.*|mcp__fs__.*|mcp_serena_.*|mcp_fs_.*",
        "timeout": 5
      },
      {
        "command": "python hooks/maintenance_hints.py",
        "matcher": "Write|StrReplace",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "python hooks/sync_on_edit.py",
        "timeout": 130
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python hooks/capture_compress_digest.py",
        "timeout": 5
      },
      {
        "command": "python hooks/r20_capture.py",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python hooks/verification_stop.py",
        "timeout": 150
      },
      {
        "command": "python hooks/context_stop.py",
        "timeout": 8,
        "loop_limit": 1
      }
    ]
  }
}
