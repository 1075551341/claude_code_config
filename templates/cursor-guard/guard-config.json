{
  "version": "1.2.17",
  "profile": "standard",
  "compression": {
    "window_tokens": 200000,
    "warn_pct": 70,
    "force_pct": 90,
    "reset_on_warn": false,
    "stop_nudge_at_warn": true,
    "auto_followup_at_force": true,
    "compress_prompt_keywords": [
      "压缩上下文",
      "压缩 上下文",
      "compact context",
      "compact 上下文"
    ],
    "extract_prompt_keywords": [
      "提取上下文",
      "提取 上下文",
      "extract context",
      "extract 上下文"
    ]
  },
  "explore": {
    "codegraph_first": true,
    "nudge_on_grep_read": true,
    "enforce_mode": "soft_block"
  },
  "sync": {
    "auto_on_edit": true,
    "debounce_seconds": 60,
    "claude_home": "%USERPROFILE%/.claude",
    "prompt_keywords": [
      "/sync",
      "同步配置",
      "sync config",
      "刷新规则",
      "更新索引",
      "更新文档",
      "同步文档"
    ]
  },
  "shell": {
    "enabled": true,
    "ask_network": true,
    "profile": "standard"
  },
  "git": {
    "forbid_auto_commit": true,
    "forbid_stash": true,
    "commit_requires_ask": true
  },
  "secrets": {
    "scan_prompts": true,
    "block_on_match": false
  },
  "verification": {
    "enabled": true,
    "enforce_mode": "off",
    "_note": "v1.2.17: Shell 警告对齐 Claude pre-bash-guard（powershell → 改用 pwsh，allow 不 deny）；sync_runner.resolve_pwsh。v1.2.16: sync_runner 只 spawn pwsh（缺则 BLOCKED）。v1.2.15: 结论标题按 Unicode 字母边界（禁止 JS `\\b` 配中文；「当前状态」不得当结论）。v1.2.14: 结论整行解析（跳过 PASS 或/or NEEDS-CHANGES 教学句）；capture 身份不读 prompt/description。v1.2.13: 审查填槽必须绑定审查者身份；结论只认标题/结论行。v1.2.12: 七维 + 审查前刷图；resume 审查 Task 不计入 reviews。v1.2.10: Stop 不能 deny；followup_message 会刷会话面板。完成门改规则驱动（修改→验证→独立审查），hook 不再注入。",
    "unverified_reminder": true,
    "prompt_keywords": ["完成了", "修好了", "测试通过", "声称完成", "done", "搞定", "fixed"]
  },
  "impact": {
    "enabled": true,
    "_note": "v1.1.9: 由「每会话首次编辑」改为「每个文件首次编辑」注入，仍不阻断"
  },
  "issue_tracker": {
    "enabled": true,
    "max_age_days": 30,
    "min_interval_sec": 120,
    "min_prompt_len": 10,
    "similarity_threshold": 0.5
  }
}
