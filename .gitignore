plan_cache.json
/config.json
.claude.json
settings.json
settings.local.json
settings.json.bak_*
.last-cleanup
.last-update-result.json
mcp-needs-auth-cache.json
*.lock

# Plugin runtime (caches, sweeps, downloaded marketplaces — regenerable)
plugins/cache/
plugins/marketplaces/
plugins/.last_inuse_sweep
plugins/*/config.json
plugins/*/config-cache/
plugins/*/context-cache/
plugins/*/transcript-cache/

# History, Logs & Backups (root-runtime, anchored)
/logs/
/history/
/file-history/
/backups/
/telemetry/
/shell-snapshots/
/daily_summary/
history.jsonl
*.log

# Editor sync targets (generated by scripts/sync.ps1, not versioned here)
.vscode
.codearts
.arts
.devin
.qoder
.trae
.qoder
.workbuddy
.codebuddy

# Workspace-local Cursor assets: OpenSpec commands/skills are配置（跟踪），
# 其余（hooks 状态等）是运行时。整目录忽略会连带吞掉 opsx 命令与 openspec 技能。
/.cursor/*
!/.cursor/commands/
!/.cursor/skills/

# Misc generated —— 仅根级运行时 txt/html；
# skills/*/LICENSE.txt 与 templates/*.txt 属配置资产，不得忽略
/*.txt
/*.html
skills/UserSkillStatus.txt

# v10.14: runtime state, secrets, temp & non-config artifacts
.credentials.json
.tmp_*.py
daemon.status.json
/jobs/
/image-cache/
/test-results/
state.json
/state/
plugins/*.bak
plugins/plugin-catalog-cache.json
plugins/known_marketplaces.json
skills/_bm_skillid_migration.json
scripts/test-guard-result.json
/.codegraph/
/.claude/
openspec/changes/
.planning/

# v10.17: 过程制品（计划/设计/执行记录）不入版本库 —— 只保留最近一次在本地。
# 配置真源是 SPEC.md 变更日志 + MANIFEST.yaml；调研（docs/research/）是配置决策依据，仍跟踪。
/spec/
/docs/superpowers/plans/
