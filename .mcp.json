{
  "$schema": "https://github.com/modelcontextprotocol/spec/blob/main/schema/schema.json",
  "_comment": "Claude MCP：仅无官方 plugin 的项（内置>plugin>MCP）。context7/exa/playwright/firecrawl 走 Plugins；chrome-devtools 默认 false，需要时中断请用户开 Plugin。github 不写 MCP。postgres 见 ops.json，中断启用。npx 钉版本。",
  "mcpServers": {
    "codegraph": {
      "_description": "R17 探索主位：符号/调用链/blast-radius/变更前影响面。钉扎 1.6.0（R14）。",
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph@1.6.0",
        "serve",
        "--mcp"
      ]
    },
    "code-review-graph": {
      "_description": "精准上下文/变更影响/风险/审查/PR。钉扎 2.3.8。经 python-mcp.ps1 清 PYTHONHOME，钉 CPython 3.12。",
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "C:\\Users\\DELL\\.claude\\scripts\\python-mcp.ps1",
        "C:\\Users\\DELL\\.local\\bin\\uvx.exe",
        "--python",
        "C:\\Python312\\python.exe",
        "--with",
        "code-review-graph==2.3.8",
        "code-review-graph",
        "serve"
      ]
    },
    "serena": {
      "_description": "Serena 符号级代码工具。经 python-mcp.ps1 清 PYTHONHOME。",
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "C:\\Users\\DELL\\.claude\\scripts\\python-mcp.ps1",
        "C:\\Users\\DELL\\.local\\bin\\serena.exe",
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        "${workspaceFolder}",
        "--open-web-dashboard",
        "false"
      ],
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=1536"
      }
    },
    "grep": {
      "_description": "grep.app 远端代码搜索。本地代码走 codegraph（R17）+ CRG（影响面/审查）。",
      "url": "https://mcp.grep.app"
    }
  }
}
