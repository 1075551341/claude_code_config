{
  "toolset": "ops",
  "description": "缓存/DB — 按需。默认不加载。Agent 禁止自动 merge。postgres 需用户设 DATABASE_URL 后自行启用。",
  "servers": [
    "redis",
    "postgres"
  ],
  "enable": "用户确认后将 mcpServers 合并到 .mcp.json 后重启；Agent 不得代 merge。",
  "note": "sqlite/docker 无官方 npm 包；需要时由用户选用并钉版本，不要写入未验证的包名。",
  "mcpServers": {
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-redis@2025.4.25",
        "redis://localhost:6379"
      ],
      "type": "stdio"
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres@0.6.2",
        "${DATABASE_URL}"
      ],
      "type": "stdio"
    }
  }
}
