{
  "_comment": "同步链常量单源（v12：cursor / qoder-cn / trae-cn / trae）。消费方：scripts/sync.ps1、scripts/check.ps1、impact_sync.py。Codex/OpenCode 解耦，不生成 AGENTS.md。",
  "root_files": [
    "CLAUDE.md",
    "SPEC.md",
    "MANIFEST.yaml",
    "skills-INDEX.md",
    "agents-INDEX.md",
    "rules-INDEX.md"
  ],
  "plugin_rule_sources": {
    "_comment": "Cursor local plugin claude-config：rules/*.md（除 README）+ 特殊映射",
    "00-CLAUDE": "CLAUDE.md",
    "CURSOR-EDITOR": "templates/cursor-guard/rules/CURSOR-EDITOR.mdc"
  },
  "frontmatter_map": {
    "cursor": {
      "keep": ["description", "name", "alwaysApply", "globs", "paths", "trigger", "layer"],
      "always_key": "alwaysApply",
      "always_value": "true",
      "lazy_trigger_key": "description"
    },
    "claude": {
      "keep": ["description", "paths"],
      "drop": ["alwaysApply", "globs", "trigger"]
    },
    "qoder-cn": {
      "keep": ["description", "alwaysApply", "globs", "paths"],
      "always_key": "alwaysApply",
      "always_value": "true"
    },
    "trae-cn": {
      "keep": ["description", "alwaysApply", "globs", "paths"],
      "always_key": "alwaysApply",
      "always_value": "true"
    },
    "trae": {
      "keep": ["description", "alwaysApply", "globs", "paths"],
      "always_key": "alwaysApply",
      "always_value": "true"
    }
  },
  "editors": {
    "_comment": "v12 仅四端。Claude Code 原生读 ~/.claude 零同步。home 缺席自动跳过。",
    "cursor": {
      "home": "~/.cursor",
      "enabled": true,
      "rules_channel": "plugin",
      "rules_ext": ".mdc",
      "root_index": true,
      "channels": {
        "root": true,
        "always_rules": true,
        "lazy_rules": true,
        "skills": "junction",
        "agents": "junction"
      }
    },
    "qoder-cn": {
      "home": "~/.qoder-cn",
      "enabled": true,
      "rules_channel": "rules",
      "rules_ext": ".mdc",
      "root_index": true,
      "channels": {
        "root": true,
        "always_rules": true,
        "lazy_rules": true
      }
    },
    "trae-cn": {
      "home": "~/.trae-cn",
      "enabled": true,
      "rules_channel": "user_rules",
      "rules_ext": ".md",
      "root_index": true,
      "channels": {
        "root": true,
        "always_rules": true,
        "lazy_rules": true
      }
    },
    "trae": {
      "home": "~/.trae",
      "enabled": true,
      "rules_channel": "user_rules",
      "rules_ext": ".md",
      "root_index": true,
      "channels": {
        "root": true,
        "always_rules": true,
        "lazy_rules": true
      }
    }
  }
}
