{
  "_comment": "Schema v2 (2026-10): source of truth = ~/.claude. Editors receive an adapted AGENTS.md (from CLAUDE.md), real-copy rules, skills/agents with .claude-managed ledgers. No symlinks/junctions. Consumed by scripts/sync.ps1, scripts/sync-editors.ps1, scripts/check.ps1, templates/cursor-guard/hooks/_lib/impact_sync.py.",
  "schema_version": 2,
  "entry_source": "CLAUDE.md",
  "entry_name": "AGENTS.md",
  "root_files": [],
  "legacy_root_files": [
    "CLAUDE.md",
    "SPEC.md",
    "MANIFEST.yaml",
    "agents-INDEX.md",
    "rules-INDEX.md",
    "skills-INDEX.md"
  ],
  "legacy_rule_files": [
    "BACKEND",
    "CONTEXT",
    "DATABASE",
    "FRONTEND",
    "GOVERNANCE",
    "WORKFLOW"
  ],
  "rules": {
    "source": "rules",
    "exclude": [
      "README.md"
    ],
    "renames": {
      "AGENTS.md": "AGENTS-COLLAB.md"
    }
  },
  "skills": {
    "source": "skills",
    "exclude": [
      "claude-mem-maintenance"
    ]
  },
  "agents": {
    "source": "agents",
    "exclude": [
      "README.md"
    ]
  },
  "editors": {
    "cursor": {
      "display": "Cursor",
      "enabled": true,
      "home": "~/.cursor",
      "entry": "plugins/local/claude-config/rules/00-AGENTS.mdc",
      "rules_dir": "plugins/local/claude-config/rules",
      "rules_ext": ".mdc",
      "rules_flavor": "cursor",
      "skills_dir": "skills",
      "agents_dir": "agents",
      "plugin_dir": "plugins/local/claude-config",
      "guard_rule": "templates/cursor-guard/rules/CURSOR-EDITOR.mdc",
      "subagent": "Task"
    },
    "qoder": {
      "display": "Qoder",
      "enabled": true,
      "home": "~/.qoder",
      "entry": "rules/AGENTS.md",
      "rules_dir": "rules",
      "rules_ext": ".md",
      "rules_flavor": "qoder",
      "skills_dir": "skills",
      "agents_dir": "agents",
      "subagent": "subagent"
    },
    "trae": {
      "display": "Trae",
      "enabled": true,
      "home": "~/.trae",
      "entry": "user_rules/AGENTS.md",
      "rules_dir": "user_rules",
      "rules_ext": ".md",
      "rules_flavor": "trae",
      "skills_dir": "skills",
      "subagent": "内置 Agent"
    },
    "trae-cn": {
      "display": "Trae CN",
      "enabled": true,
      "home": "~/.trae-cn",
      "entry": "user_rules/AGENTS.md",
      "rules_dir": "user_rules",
      "rules_ext": ".md",
      "rules_flavor": "trae",
      "skills_dir": "skills",
      "subagent": "内置 Agent"
    },
    "qoder-cn": {
      "display": "Qoder CN",
      "enabled": false,
      "home": "~/.qoder-cn",
      "entry": "rules/AGENTS.md",
      "rules_dir": "rules",
      "rules_ext": ".md",
      "rules_flavor": "qoder",
      "skills_dir": "skills",
      "agents_dir": "agents",
      "subagent": "subagent"
    },
    "workbuddy": {
      "display": "WorkBuddy",
      "enabled": false,
      "home": "~/.workbuddy"
    },
    "codearts": {
      "display": "CodeArts",
      "enabled": false,
      "home": "~/.codeartsdoer"
    },
    "opencode": {
      "_comment": "OpenCode owns ~/.config/opencode/AGENTS.md; never sync CLAUDE.md there.",
      "display": "OpenCode",
      "enabled": false,
      "home": "~/.config/opencode"
    }
  }
}
