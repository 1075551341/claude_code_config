{
  "quality_gates": {
    "schema_drift": {
      "enabled": true,
      "check_orm_changes": true,
      "description": "检测ORM变更是否缺少对应migration（stop-verification-gate 启发式提醒：model/ORM 文件变更无 migration → 警告）"
    },
    "security_anchor": {
      "enabled": true,
      "check_auth_bindings": true,
      "description": "检查验证逻辑是否绑定到威胁模型（auth 相关变更 → 提醒绑定威胁模型）"
    },
    "scope_reduction": {
      "enabled": true,
      "compare_plan_vs_impl": true,
      "description": "检查planner是否静默丢弃需求（存在活跃 plan/spec 制品时强制对照 tasks 清单）"
    },
    "impact_manifest_gate": {
      "enabled": true,
      "platforms": ["claude-code", "cursor"],
      "description": "清单制品+diff差集校验（design-v2 方案A）：PostToolUse 记 git 基线并提醒落盘 IMPACT 制品；Stop 门比对 当前脏集−基线集 ⊆ 清单集，超集=followup（错改/漏改硬证据）。非git仓库静默降级 DONE_WITH_CONCERNS"
    }
  },
  "verification_gate": {
    "enabled": true,
    "max_blocks": 3,
    "auto_check_timeout_sec": 25,
    "skip_keywords": [
      "跳过验证",
      "不用验证",
      "skip verify"
    ],
    "verify_command_patterns": [
      "pytest",
      "vitest",
      "jest",
      "npm test",
      "pnpm test",
      "yarn test",
      "npm run test",
      "npm run lint",
      "npm run build",
      "pnpm lint",
      "pnpm build",
      "tsc",
      "mypy",
      "ruff",
      "eslint",
      "clippy",
      "cargo test",
      "cargo check",
      "go test",
      "go vet"
    ],
    "reviewer_agents": [
      "eng-reviewer",
      "qa",
      "code-reviewer",
      "dx-reviewer",
      "spec-reviewer"
    ],
    "require_reviewer_min_files": 1,
    "review_max_rounds": 3,
    "review_cycle": "modify-verify-review",
    "require_requirements_replay": true,
    "requirement_fingerprint": true,
    "require_review_verdict": true,
    "verdict_trigger_min_blocks": 2,
    "require_crg_when_graph": true,
    "require_dual_graph_before_review": true,
    "parallel_review": {
      "enabled": true,
      "when_all": ["reviewers_readonly", "disjoint_concerns", "model_inherit_only"],
      "forbid_multiplier_models": true,
      "require_model": "inherit",
      "max_parallel": 3,
      "description": "v11.4.14：Stop/Guard 消费本键。独立审前双图 ensure；只读+维度不重叠+子代理 inherit（禁止倍率档）才允许并行多审查"
    },
    "doc_only_extensions": [
      ".md",
      ".txt",
      ".rst",
      ".markdown"
    ]
  },
  "graph_freshness": {
    "enabled": true,
    "session_ensure_timeout_sec": 120,
    "pretool_ensure_timeout_sec": 90,
    "stop_refresh_timeout_sec": 30,
    "sync_ps1_timeout_sec": 120,
    "require_both_graphs": true,
    "subproject_discovery": true,
    "subproject_max_children": 8,
    "description": "v11.4.14 图谱保鲜硬门：SessionStart/Stop 双图 ensure/refresh；独立审前再 ensure；已有图时 CLI 失败记警告不阻断；无图 PreToolUse deny；仅验证全绿后 sync.ps1。子项目 depth-1 封顶。"
  },
  "issue_tracker": {
    "enabled": true,
    "max_age_days": 30,
    "min_interval_sec": 120,
    "min_prompt_len": 10,
    "description": "问题指纹追踪（v11.1.1 相似匹配重构）：分层特征（strong=路径/错误码/符号，weak=英文词+中文bigram）+ 加权相似度阈值；泛化追问续接不建桶；resolved 回归自动升级硬提醒；仅注入不阻断；状态 ~/.claude/.state/issue-tracker.json（双端共用）",
    "similarity_threshold": 0.5
  }
}
